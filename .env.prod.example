# ═══════════════════════════════════════════════════
# LMS MVP — Production Environment Variables
# Copy this file to .env.prod and fill in the values
# ═══════════════════════════════════════════════════

# Database
POSTGRES_USER=lmsuser
POSTGRES_PASSWORD=<strong-password-here>
POSTGRES_DB=lmsdb
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lmsdb
SPRING_DATASOURCE_USERNAME=lmsuser
SPRING_DATASOURCE_PASSWORD=<strong-password-here>

# JWT (generate a 32+ character random secret)
JWT_SECRET=<generate-with: openssl rand -base64 48>

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<strong-password-here>
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<same-as-MINIO_ROOT_PASSWORD>
MINIO_BUCKET=lms-content

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend
FRONTEND_URL=https://your-domain.com
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_STRIPE_PUBLIC_KEY=pk_live_...

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Email (Gmail example — use app password, not main password)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=<app-specific-password>
MAIL_FROM=noreply@your-domain.com

# AI (optional)
AI_TUTOR_ENABLED=false
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=claude-sonnet-4-20250514
AI_GRADING_ENABLED=false
AI_GRADING_API_KEY=
