# ═══════════════════════════════════════════════════
# LMS MVP — Local overrides for docker-compose
# Copy to .env to override the committed dev defaults.
# Anything committed in docker-compose.yml is public —
# always set your own values outside local development.
# ═══════════════════════════════════════════════════

# Database (changing these requires: docker compose down -v)
#POSTGRES_DB=lmsdb
#POSTGRES_USER=lmsuser
#POSTGRES_PASSWORD=<openssl rand -hex 16>

# MinIO (root credentials; the backend and minio-init reuse them)
#MINIO_ROOT_USER=lmsminio
#MINIO_ROOT_PASSWORD=<openssl rand -hex 16>

# JWT signing secret — 32+ chars for HS256
#JWT_SECRET=<openssl rand -base64 48>

# Stripe test-mode keys (dashboard.stripe.com -> Developers -> API keys)
# Webhook secret comes from `stripe listen --forward-to localhost:8080/api/payments/webhook`
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
